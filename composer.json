{
  "name": "sivasakthi/jeephp",
  "description": "A readable PHP framework with simple database helpers and optional AuthO and RolesO packages.",
  "license": "MIT",
  "type": "project",
  "keywords": ["jeephp", "php-framework"],
  "require": {
    "php": ">=8.2.35 <8.3 || >=8.3.36 <8.4 || >=8.4.27 <8.5 || >=8.5.12 <8.6",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-mbstring": "*"
  },
  "autoload": {
    "psr-4": {
      "JeePHP\\": "src/JeePHP/",
      "App\\": "app/"
    },
    "files": [
      "src/JeePHP/Support/helpers.php",
      "app/Helpers/helpers.php"
    ]
  },
  "scripts": {
    "post-create-project-cmd": [
      "@php -r \"file_exists('.duck') || copy('.duck.example', '.duck');\""
    ]
  }
}
