#!/usr/bin/env php
<?php
declare(strict_types=1);

use JeePHP\Database\Migrator;
use JeePHP\Backup\BackupCrypto;
use JeePHP\Backup\DatabaseBackup;
use JeePHP\Backup\GoogleDriveBackup;
use JeePHP\Jobs\Queue;
use JeePHP\Jobs\QueueableJob;
use JeePHP\Packages\CrudGenerator;
use JeePHP\Packages\PackageActivator;
use JeePHP\Schedule\Scheduler;
use JeePHP\Testing\TestRunner;
use JeePHP\Testing\IntegrationRunner;

// Keep this diagnostic available even when Composer or the runtime gate blocks startup.
if (($argv[1] ?? '') === 'security:check') {
    require_once dirname(__DIR__) . '/src/JeePHP/Security/Platform.php';
    $minimum = \JeePHP\Security\Platform::minimum();
    echo 'JeePHP PHP runtime security check' . "\n";
    echo '  PHP binary: ' . PHP_BINARY . "\n";
    echo '  PHP version: ' . PHP_VERSION . "\n";
    echo '  Required patch on this branch: ' . ($minimum ?? 'unsupported PHP branch') . "\n";
    echo '  Result: ' . (\JeePHP\Security\Platform::isPatched() ? 'PASS' : 'FAIL') . "\n";
    echo "  Check Apache/FPM PHP separately; this command checks only the CLI binary.\n";
    exit(\JeePHP\Security\Platform::isPatched() ? 0 : 1);
}

require dirname(__DIR__) . '/bootstrap/app.php';

$command = $argv[1] ?? 'help';
$argument = $argv[2] ?? null;
$root = dirname(__DIR__);

// Keep the common Artisan-style help/list spellings on the same CLI.
if (in_array($command, ['list', '--help', '-h'], true)) {
    $command = 'help';
}

try {
    if (in_array($command, ['new', 'create'], true) && $argument !== null) {
        assertSafeName($argument);
        $destination = getcwd() . DIRECTORY_SEPARATOR . $argument;
        if (file_exists($destination)) {
            throw new RuntimeException('Folder already exists: ' . $destination);
        }

        mkdir($destination, 0775, true);
        try {
            foreach (['app', 'bin', 'bootstrap', 'config', 'database', 'docs', 'packages', 'public', 'routes', 'src', 'tests'] as $folder) {
                copyDirectory($root . '/' . $folder, $destination . '/' . $folder);
            }
            foreach (['.duck.example', '.gitignore', '.htaccess', 'README.md', 'AUDIT-REPORT.md', 'SECURITY-RELEASE.md', 'AUTHO-UPDATE-GUIDE.txt', 'INTEGRATION-TESTS.md', 'composer.json', 'artisan', 'artisan.bat', 'index.php', 'jeep', 'jeep.bat', 'server.php'] as $file) {
                if (is_file($root . '/' . $file)) {
                    copy($root . '/' . $file, $destination . '/' . $file);
                }
            }

            $configExample = $destination . '/.duck.example';
            $config = file_get_contents($configExample);
            file_put_contents($configExample, preg_replace('/^APP_NAME=.*/m', 'APP_NAME=' . $argument, $config) ?? $config);
            copy($configExample, $destination . '/.duck');

            $composerFile = $destination . '/composer.json';
            $composer = json_decode((string) file_get_contents($composerFile), true, 512, JSON_THROW_ON_ERROR);
            $slug = strtolower((string) preg_replace('/[^A-Za-z0-9]+/', '-', $argument));
            $composer['name'] = 'jeep/' . trim($slug, '-');
            file_put_contents($composerFile, json_encode($composer, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . "\n");

            $readmeFile = $destination . '/README.md';
            $readme = file_get_contents($readmeFile);
            file_put_contents($readmeFile, preg_replace('/^# JeePHP 1\.0\.0/m', '# ' . $argument, $readme, 1) ?? $readme);
        } catch (Throwable $exception) {
            removeDirectory($destination);
            throw $exception;
        }

        echo 'Created ' . $argument . "\n\n";
        echo '  cd ' . $argument . "\n";
        echo "  composer install\n";
        echo "  Set DB_NAME, DB_USER, and DB_PASS in .duck.\n";
        echo "  php artisan serve\n";
        echo "  php artisan migrate\n";
        exit(0);
    }

    if ($command === 'serve') {
        $address = $argument ?? '127.0.0.1:8000';
        if (preg_match('/^[0-9]{1,5}$/', $address)) {
            $address = '127.0.0.1:' . $address;
        }
        if (!preg_match('/^(?:\[[0-9a-fA-F:]+\]|[A-Za-z0-9.-]+):([0-9]{1,5})$/', $address, $matches)
            || (int) $matches[1] < 1 || (int) $matches[1] > 65535) {
            throw new InvalidArgumentException('Use php artisan serve, php artisan serve 8080, or php artisan serve 127.0.0.1:8080.');
        }

        $public = $root . DIRECTORY_SEPARATOR . 'public';
        $router = $root . DIRECTORY_SEPARATOR . 'server.php';
        if (!is_file($public . DIRECTORY_SEPARATOR . 'index.php') || !is_file($router)) {
            throw new RuntimeException('The public folder or server.php file is missing.');
        }

        echo "JeePHP development server\n";
        echo '  http://' . $address . "\n";
        echo "  Press Ctrl+C to stop.\n\n";
        $serverCommand = escapeshellarg(PHP_BINARY)
            . ' -S ' . escapeshellarg($address)
            . ' -t ' . escapeshellarg($public)
            . ' ' . escapeshellarg($router);
        passthru($serverCommand, $exitCode);
        exit($exitCode);
    }

    if ($command === 'migrate') {
        $names = (new Migrator($root . '/database/migrations'))->run();
        echo $names === [] ? "Nothing to migrate.\n" : 'Migrated: ' . implode(', ', $names) . "\n";
        exit(0);
    }

    if ($command === 'migrate:rollback') {
        $names = (new Migrator($root . '/database/migrations'))->rollback();
        echo $names === [] ? "Nothing to roll back.\n" : 'Rolled back: ' . implode(', ', $names) . "\n";
        exit(0);
    }

    if ($command === 'package:list') {
        foreach (PackageActivator::available($root) as $package) {
            echo str_pad($package['name'], 12) . ($package['active'] ? 'active' : 'available') . "\n";
        }
        exit(0);
    }

    if ($command === 'auth:upgrade') {
        requireActivePackage($root, 'AuthO');
        \JeePHP\Security\AuthRateLimiter::installSchema(\JeePHP\Database\Database::connection());
        echo "AuthO rate limit table is ready. Existing users and passwords were not changed.\n";
        exit(0);
    }

    if ($command === 'make:model' && $argument !== null) {
        assertSafeName($argument);
        $class = studly($argument);
        $path = $root . '/app/Models/' . $class . '.php';
        $table = snakePlural($class);
        writeNewFile($path, "<?php\ndeclare(strict_types=1);\n\nnamespace App\\Models;\n\nuse JeePHP\\Database\\Model;\n\nfinal class {$class} extends Model\n{\n    protected static string \$table = '{$table}';\n\n    protected array \$fillable = [];\n}\n");
        echo 'Created app/Models/' . $class . ".php\n";
        exit(0);
    }

    if ($command === 'make:crud' && $argument !== null) {
        requireActivePackage($root, 'CrudO');
        $fields = isset($argv[3]) ? explode(',', (string) $argv[3]) : ['name', 'description'];
        $fields = array_values(array_filter(array_map('trim', $fields), static fn (string $field): bool => $field !== ''));
        $files = (new CrudGenerator($root))->generate($argument, $fields);
        echo "CRUD module created:\n  " . implode("\n  ", $files) . "\n\nRun php artisan migrate, then open /" . snakePlural(studly($argument)) . ".\n";
        exit(0);
    }

    if ($command === 'make:controller' && $argument !== null) {
        assertSafeName($argument);
        $class = str_ends_with($argument, 'Controller') ? studly($argument) : studly($argument) . 'Controller';
        $path = $root . '/app/Controllers/' . $class . '.php';
        writeNewFile($path, "<?php\ndeclare(strict_types=1);\n\nnamespace App\\Controllers;\n\nuse JeePHP\\Http\\Request;\n\nfinal class {$class}\n{\n    public function index(Request \$request): string\n    {\n        return 'Ready for your code';\n    }\n}\n");
        echo 'Created app/Controllers/' . $class . ".php\n";
        exit(0);
    }

    if (in_array($command, ['make:logic', 'make:business'], true) && $argument !== null) {
        assertSafeName($argument);
        $class = studly($argument);
        $path = $root . '/app/BusinessLogic/' . $class . '.php';
        $stub = "<?php\ndeclare(strict_types=1);\n\nnamespace App\\BusinessLogic;\n\nfinal class {$class}\n{\n    public function handle(): mixed\n    {\n        // Put reusable business rules here.\n        return null;\n    }\n}\n";
        writeNewFile($path, $stub);
        echo 'Created app/BusinessLogic/' . $class . ".php\n";
        exit(0);
    }

    if (in_array($command, ['make:migration', 'migrate:create', 'create-migration'], true) && $argument !== null) {
        $table = normalizeMigrationTable($argument);
        $fileName = date('Ymd_His') . '_create_' . $table . '_table.php';
        $path = $root . '/database/migrations/' . $fileName;
        $stub = "<?php\ndeclare(strict_types=1);\n\nuse JeePHP\\Database\\Migration;\n\nreturn new class implements Migration {\n    public function up(\\PDO \$database): void\n    {\n        create_table('{$table}')\n            ->column('name', 'email')\n            ->timestamps()\n            ->create();\n    }\n\n    public function down(\\PDO \$database): void\n    {\n        drop_table('{$table}');\n    }\n};\n";
        writeNewFile($path, $stub);
        echo 'Created database/migrations/' . basename($path) . "\n";
        exit(0);
    }

    if ($command === 'make:job' && $argument !== null) {
        assertSafeName($argument);
        $class = studly($argument);
        $path = $root . '/app/Jobs/' . $class . '.php';
        $stub = "<?php\ndeclare(strict_types=1);\n\nnamespace App\\Jobs;\n\nuse JeePHP\\Jobs\\QueueableJob;\n\nfinal class {$class} implements QueueableJob\n{\n    public function handle(array \$payload = []): void\n    {\n        // Add the work for this job here. Values are available in \$payload.\n    }\n}\n";
        writeNewFile($path, $stub);
        echo 'Created app/Jobs/' . $class . ".php\n";
        exit(0);
    }

    if ($command === 'make:test' && $argument !== null) {
        requireActivePackage($root, 'TestO');
        assertSafeName($argument);
        $name = str_ends_with($argument, 'Test') ? $argument : $argument . 'Test';
        $path = $root . '/tests/' . $name . '.php';
        $stub = "<?php\ndeclare(strict_types=1);\n\nuse JeePHP\\Testing\\TestCase;\n\nreturn static function (TestCase \$test): void {\n    \$test->same(4, 2 + 2);\n    \$test->assertTrue(true);\n};\n";
        writeNewFile($path, $stub);
        echo 'Created tests/' . $name . ".php\n";
        exit(0);
    }

    if ($command === 'test') {
        requireActivePackage($root, 'TestO');
        exit((new TestRunner())->run($root . '/tests'));
    }

    if ($command === 'test:integration') {
        exit((new IntegrationRunner($root))->run(optionValue($argv, '--base-url=', (string) (getenv('APP_URL') ?: ''))));
    }

    if ($command === 'queue:work') {
        requireActivePackage($root, 'QueueO');
        $once = in_array('--once', $argv, true);
        $sleepSeconds = max(1, min(30, (int) optionValue($argv, '--sleep=', '2')));
        echo $once ? "Running one queued job...\n" : "JeePHP queue worker running. Press Ctrl+C to stop.\n";
        do {
            $worked = Queue::workOne();
            if ($worked) {
                echo '[' . date('H:i:s') . "] Processed a queued job.\n";
            } elseif ($once) {
                echo "No ready jobs.\n";
            } else {
                sleep($sleepSeconds);
            }
        } while (!$once);
        exit(0);
    }

    if ($command === 'queue:failed') {
        requireActivePackage($root, 'QueueO');
        $failed = Queue::failed();
        if ($failed === []) {
            echo "No failed jobs.\n";
        }
        foreach ($failed as $job) {
            echo '#' . $job['id'] . ' ' . $job['job_class'] . ' (' . $job['attempts'] . ' tries) ' . $job['last_error'] . "\n";
        }
        exit(0);
    }

    if ($command === 'queue:retry' && $argument !== null) {
        requireActivePackage($root, 'QueueO');
        $id = filter_var($argument, FILTER_VALIDATE_INT);
        if ($id === false || $id < 1) {
            throw new InvalidArgumentException('Usage: php artisan queue:retry JOB_ID');
        }
        $statement = \JeePHP\Database\Database::connection()->prepare(
            "UPDATE jeep_jobs SET status='queued', attempts=0, available_at=UTC_TIMESTAMP(), reserved_at=NULL, failed_at=NULL, last_error=NULL WHERE id=:id AND status='failed'"
        );
        $statement->execute(['id' => $id]);
        echo $statement->rowCount() === 1 ? "Job queued for retry.\n" : "Failed job not found.\n";
        exit($statement->rowCount() === 1 ? 0 : 1);
    }

    if ($command === 'schedule:run') {
        requireActivePackage($root, 'ScheduleO');
        $count = (new Scheduler($root))->run();
        echo 'Scheduled jobs started: ' . $count . "\n";
        exit(0);
    }

    if ($command === 'mail:test' && $argument !== null) {
        requireActivePackage($root, 'MailO');
        send_mail($argument, 'JeePHP SMTP test', 'emails/welcome', ['name' => 'JeePHP developer']);
        echo 'Test email sent to ' . $argument . ".\n";
        exit(0);
    }

    if ($command === 'cache:clear') {
        requireActivePackage($root, 'CacheO');
        $removed = (new \JeePHP\Cache\FileCache($root . '/storage/cache'))->clear();
        echo 'Cache entries removed: ' . $removed . "\n";
        exit(0);
    }

    if ($command === 'log:tail') {
        requireActivePackage($root, 'LogO');
        $lines = max(1, min(500, (int) optionValue($argv, '--lines=', '50')));
        $files = glob($root . '/storage/logs/*.log') ?: [];
        rsort($files);
        $content = '';
        foreach ($files as $file) {
            $part = file($file, FILE_IGNORE_NEW_LINES);
            if (is_array($part)) {
                $content = implode("\n", array_merge($part, $content === '' ? [] : explode("\n", $content)));
            }
            if (substr_count($content, "\n") >= $lines) {
                break;
            }
        }
        $output = array_slice(explode("\n", $content), -$lines);
        echo $output === [''] ? "No log records.\n" : implode("\n", $output) . "\n";
        exit(0);
    }

    if ($command === 'api:token' && isset($argv[2], $argv[3])) {
        requireActivePackage($root, 'APIO');
        $userId = filter_var($argv[2], FILTER_VALIDATE_INT);
        if ($userId === false || $userId < 1) {
            throw new InvalidArgumentException('Usage: php artisan api:token USER_ID NAME [ability1,ability2] [--expires=YYYY-MM-DD]');
        }
        $abilities = isset($argv[4]) && !str_starts_with($argv[4], '--') ? explode(',', $argv[4]) : ['*'];
        $expires = optionValue($argv, '--expires=', '') ?: null;
        $token = \JeePHP\Api\ApiTokens::create($userId, $argv[3], $abilities, $expires);
        echo "Copy this token now. JeePHP stores only its hash:\n" . $token . "\n";
        exit(0);
    }

    if ($command === 'api:revoke' && isset($argv[2], $argv[3])) {
        requireActivePackage($root, 'APIO');
        $tokenId = filter_var($argv[2], FILTER_VALIDATE_INT);
        $userId = filter_var($argv[3], FILTER_VALIDATE_INT);
        if ($tokenId === false || $tokenId < 1 || $userId === false || $userId < 1) {
            throw new InvalidArgumentException('Usage: php artisan api:revoke TOKEN_ID USER_ID');
        }
        $revoked = \JeePHP\Api\ApiTokens::revoke($tokenId, $userId);
        echo $revoked ? "API token revoked.\n" : "API token not found for that user.\n";
        exit($revoked ? 0 : 1);
    }

    if ($command === 'backup:key-generate') {
        requireActivePackage($root, 'BackupO');
        echo "Add this line to .duck and keep a separate copy of the key:\n\nBACKUP_ENCRYPTION_KEY=" . BackupCrypto::generateKey() . "\n";
        exit(0);
    }

    if ($command === 'drive:connect' && $argument !== null) {
        requireActivePackage($root, 'BackupO');
        $backupConfig = require $root . '/config/backup.php';
        (new GoogleDriveBackup($root . '/storage/private', (string) $backupConfig['drive_folder_name'], (int) $backupConfig['chunk_bytes']))->connect($argument);
        exit(0);
    }

    if ($command === 'drive:disconnect') {
        requireActivePackage($root, 'BackupO');
        $backupConfig = require $root . '/config/backup.php';
        (new GoogleDriveBackup($root . '/storage/private', (string) $backupConfig['drive_folder_name'], (int) $backupConfig['chunk_bytes']))->disconnect();
        exit(0);
    }

    if ($command === 'drive:status') {
        requireActivePackage($root, 'BackupO');
        $tokenPath = $root . '/storage/private/google-drive-token.json';
        echo is_file($tokenPath) ? "Google Drive authorization is configured.\n" : "Google Drive is not connected. Run php artisan drive:connect path/to/oauth-client.json.\n";
        exit(is_file($tokenPath) ? 0 : 1);
    }

    if ($command === 'backup:database') {
        requireActivePackage($root, 'BackupO');
        $backupConfig = require $root . '/config/backup.php';
        $key = (string) ($backupConfig['encryption_key'] ?? '');
        $toDrive = in_array('--drive', $argv, true);
        if ($toDrive && $key === '') {
            throw new RuntimeException('Drive backups must be encrypted. Run php artisan backup:key-generate and add the key to .duck first.');
        }
        $manager = new DatabaseBackup((string) $backupConfig['directory']);
        $path = $manager->create($key !== '', $key);
        echo 'Local backup created: ' . $path . "\n";
        if ($key === '') {
            echo "NOTICE: this backup is compressed but not encrypted. Run php artisan backup:key-generate and keep the key outside this project for encrypted backups.\n";
        } else {
            echo "Backup is encrypted with BACKUP_ENCRYPTION_KEY. Keep a separate copy of that key; it cannot be recovered from the backup.\n";
        }
        if ($toDrive) {
            $drive = new GoogleDriveBackup($root . '/storage/private', (string) $backupConfig['drive_folder_name'], (int) $backupConfig['chunk_bytes']);
            $file = $drive->upload($path);
            echo 'Uploaded to Google Drive: ' . ($file['name'] ?? basename($path)) . "\n";
            echo 'Drive file ID: ' . $file['id'] . "\n";
        }
        exit(0);
    }

    if ($command === 'backup:list') {
        requireActivePackage($root, 'BackupO');
        $backupConfig = require $root . '/config/backup.php';
        if (in_array('--drive', $argv, true)) {
            $drive = new GoogleDriveBackup($root . '/storage/private', (string) $backupConfig['drive_folder_name'], (int) $backupConfig['chunk_bytes']);
            foreach ($drive->list() as $file) {
                echo ($file['createdTime'] ?? '') . '  ' . ($file['name'] ?? '') . '  ID=' . ($file['id'] ?? '') . "\n";
            }
        } else {
            $files = (new DatabaseBackup((string) $backupConfig['directory']))->localBackups();
            foreach ($files as $file) {
                echo basename($file) . '  ' . number_format(filesize($file)) . " bytes\n";
            }
            if ($files === []) {
                echo "No local backups found.\n";
            }
        }
        exit(0);
    }

    if ($command === 'backup:clean') {
        requireActivePackage($root, 'BackupO');
        $backupConfig = require $root . '/config/backup.php';
        $keep = (int) optionValue($argv, '--keep=', '7');
        if ($keep < 1) {
            throw new InvalidArgumentException('Use --keep=1 or a larger number.');
        }
        if (in_array('--drive', $argv, true)) {
            echo 'This permanently deletes Google Drive backups beyond the newest ' . $keep . '. Type DELETE to continue: ';
            if (trim((string) fgets(STDIN)) !== 'DELETE') {
                throw new RuntimeException('Backup cleanup cancelled.');
            }
        }
        $local = (new DatabaseBackup((string) $backupConfig['directory']))->prune($keep);
        echo 'Local backups removed: ' . $local . "\n";
        if (in_array('--drive', $argv, true)) {
            $drive = new GoogleDriveBackup($root . '/storage/private', (string) $backupConfig['drive_folder_name'], (int) $backupConfig['chunk_bytes']);
            echo 'Drive backups removed: ' . $drive->prune($keep) . "\n";
        }
        exit(0);
    }

    if ($command === 'backup:restore') {
        requireActivePackage($root, 'BackupO');
        if (!in_array('--force', $argv, true)) {
            throw new InvalidArgumentException('Restore replaces database tables. Add --force and type RESTORE when prompted.');
        }
        $backupConfig = require $root . '/config/backup.php';
        $key = (string) ($backupConfig['encryption_key'] ?? '');
        $driveRequested = in_array('--drive', $argv, true);
        $driveId = $driveRequested ? ($argv[3] ?? '') : '';
        $path = '';
        if ($driveRequested) {
            if (!is_string($driveId) || preg_match('/^[A-Za-z0-9_-]{10,200}$/', $driveId) !== 1) {
                throw new InvalidArgumentException('Usage: php artisan backup:restore --drive FILE_ID --force');
            }
            BackupCrypto::validateKey($key);
        } else {
            $requested = (string) ($argv[2] ?? '');
            if ($requested === '' || str_starts_with($requested, '--')) {
                throw new InvalidArgumentException('Usage: php artisan backup:restore BACKUP_FILE --force');
            }
            $path = is_file($requested)
                ? $requested
                : rtrim((string) $backupConfig['directory'], '/\\') . '/' . basename($requested);
            if (!is_file($path) || !is_readable($path)) {
                throw new RuntimeException('Backup file not found: ' . $requested);
            }
            if (!str_ends_with($path, '.sql.gz') && !str_ends_with($path, '.sql.gz.enc')) {
                throw new InvalidArgumentException('Restore expects a .sql.gz or .sql.gz.enc JeePHP backup.');
            }
            if (str_ends_with($path, '.enc')) {
                BackupCrypto::validateKey($key);
            }
        }
        echo "WARNING: this replaces existing tables and their data. Type RESTORE to continue: ";
        $confirmation = trim((string) fgets(STDIN));
        if ($confirmation !== 'RESTORE') {
            throw new RuntimeException('Restore cancelled.');
        }
        if ($driveRequested) {
            $path = rtrim((string) $backupConfig['directory'], '/\\') . '/drive-restore-' . bin2hex(random_bytes(6)) . '.sql.gz.enc';
            $drive = new GoogleDriveBackup($root . '/storage/private', (string) $backupConfig['drive_folder_name'], (int) $backupConfig['chunk_bytes']);
            $drive->download($driveId, $path);
        }
        $count = (new DatabaseBackup((string) $backupConfig['directory']))->restore($path, $key);
        echo 'Restore completed. SQL statements applied: ' . $count . "\n";
        exit(0);
    }

    if ($command === 'job:run' && $argument !== null) {
        assertSafeName($argument);
        $class = 'App\\Jobs\\' . studly($argument);
        if (!class_exists($class)) {
            throw new RuntimeException('Job class not found: ' . $class);
        }
        $job = new $class();
        if ($job instanceof QueueableJob) {
            $job->handle([]);
        } elseif ($job instanceof \JeePHP\Jobs\Job) {
            $job->handle();
        } else {
            throw new RuntimeException('Job must implement JeePHP\\Jobs\\Job or QueueableJob: ' . $class);
        }
        echo 'Completed job: ' . $class . "\n";
        exit(0);
    }

    if (in_array($command, ['--version', '-V', 'version'], true)) {
        echo 'JeePHP ' . (require $root . '/config/app.php')['version'] . "\n";
        exit(0);
    }

    if ($command === 'activate' && $argument !== null) {
        (new PackageActivator($root))->activate($argument);
        exit(0);
    }

    if ($command === 'role:assign' && isset($argv[2], $argv[3])) {
        $userId = filter_var($argv[2], FILTER_VALIDATE_INT);
        if ($userId === false || $userId < 1) {
            throw new InvalidArgumentException('Usage: php artisan role:assign USER_ID ROLE_NAME');
        }
        assertSafeName($argv[3]);
        if (!function_exists('assign_role')) {
            throw new RuntimeException('Role helpers are missing. Activate RolesO and run composer dump-autoload.');
        }
        assign_role($userId, strtolower($argv[3]));
        echo 'Assigned role ' . strtolower($argv[3]) . ' to user ' . $userId . ".\n";
        exit(0);
    }

    if ($command === 'permission:grant' && isset($argv[2], $argv[3])) {
        assertSafeName($argv[2]);
        if (!preg_match('/^[A-Za-z][A-Za-z0-9._-]*$/', $argv[3])) {
            throw new InvalidArgumentException('Use a valid permission name, such as roles.manage.');
        }
        if (!function_exists('grant_permission')) {
            throw new RuntimeException('Role helpers are missing. Activate RolesO and run composer dump-autoload.');
        }
        grant_permission(strtolower($argv[2]), strtolower($argv[3]));
        echo 'Granted ' . strtolower($argv[3]) . ' to role ' . strtolower($argv[2]) . ".\n";
        exit(0);
    }

    echo "JeePHP Artisan-style command line\n";
    echo "Run php artisan, php artisan list, or php artisan --help to show this command list.\n\n";
    echo "  php artisan --version                     Show the framework version\n";
    echo "  php artisan security:check                Check this CLI PHP runtime patch\n";
    echo "  php artisan create MyApp                   Create a project in this folder\n";
    echo "  php artisan new MyApp                      Alias for create\n";
    echo "  php artisan serve [port|host:port]          Run locally without Apache/XAMPP\n";
    echo "  php artisan migrate                         Run pending migrations\n";
    echo "  php artisan migrate:rollback                Undo the latest migration batch\n";
    echo "  php artisan make:model Customer             Create a model\n";
    echo "  php artisan make:controller Customer        Create a controller\n";
    echo "  php artisan make:logic RegisterCustomer     Create a business-logic class\n";
    echo "  php artisan migrate:create users            Create a table migration\n";
    echo "  php artisan package:list                    List JeePHP optional packages\n";
    echo "  php artisan activate PACKAGE                Activate a built-in package\n";
    echo "  php artisan auth:upgrade                    Add AuthO shared rate limits to existing apps\n";
    echo "  php artisan make:crud Product name,price     Generate a CRUD module\n";
    echo "  php artisan make:job SendReport              Create a queueable job\n";
    echo "  php artisan queue:work [--once]              Process background jobs\n";
    echo "  php artisan queue:failed                     List jobs that exhausted retries\n";
    echo "  php artisan schedule:run                     Run due scheduled jobs\n";
    echo "  php artisan make:test UserTest               Create a test file\n";
    echo "  php artisan test                             Run project tests\n";
    echo "  php artisan test:integration --base-url=http://localhost/JeePHPIntegration  Test a disposable local project\n";
    echo "  php artisan mail:test user@example.com       Send a test email\n";
    echo "  php artisan cache:clear                     Clear file cache entries\n";
    echo "  php artisan log:tail [--lines=50]            Read recent application logs\n";
    echo "  php artisan api:token 1 app users.read        Create an API token\n";
    echo "  php artisan api:revoke TOKEN_ID USER_ID      Revoke an API token\n";
    echo "  php artisan backup:key-generate              Generate a backup encryption key\n";
    echo "  php artisan drive:connect oauth-client.json  Connect this CLI to Google Drive\n";
    echo "  php artisan backup:database [--drive]         Back up MySQL/MariaDB\n";
    echo "  php artisan backup:list [--drive]             List backups\n";
    echo "  php artisan backup:restore FILE --force       Restore local backup after confirmation\n";
    echo "  php artisan backup:restore --drive FILE_ID --force  Restore a Drive backup\n";
    echo "  php artisan backup:clean --keep=7 [--drive]   Remove old backups (Drive asks first)\n";
    echo "  php artisan backup:list --drive               List Google Drive backups\n";
    echo "  php artisan drive:status | drive:disconnect   Check or disconnect Drive\n";
    echo "  php artisan role:assign 1 admin             Assign a role to a user\n";
    echo "  php artisan permission:grant admin roles.manage  Grant a permission to a role\n";
} catch (Throwable $exception) {
    fwrite(STDERR, 'Error: ' . $exception->getMessage() . "\n");
    exit(1);
}

function writeNewFile(string $path, string $contents): void
{
    if (is_file($path)) {
        throw new RuntimeException('File already exists: ' . $path);
    }
    if (!is_dir(dirname($path))) {
        mkdir(dirname($path), 0775, true);
    }
    file_put_contents($path, $contents);
}

function requireActivePackage(string $root, string $name): void
{
    if (!is_file($root . '/storage/packages/' . $name . '.active')) {
        throw new RuntimeException('Activate this package first: php artisan activate ' . $name);
    }
}

function optionValue(array $arguments, string $prefix, string $default): string
{
    foreach ($arguments as $argument) {
        if (is_string($argument) && str_starts_with($argument, $prefix)) {
            return substr($argument, strlen($prefix));
        }
    }
    return $default;
}

function copyDirectory(string $source, string $destination): void
{
    if (!is_dir($source) || is_link($source)) {
        throw new RuntimeException('Framework template folder not found: ' . $source);
    }
    if (!is_dir($destination)) {
        mkdir($destination, 0775, true);
    }
    foreach (scandir($source) ?: [] as $name) {
        if ($name === '.' || $name === '..' || $name === '.duck' || $name === '.DS_Store' || $name === '.git' || $name === 'vendor') {
            continue;
        }
        $sourcePath = $source . DIRECTORY_SEPARATOR . $name;
        $targetPath = $destination . DIRECTORY_SEPARATOR . $name;
        if (is_link($sourcePath)) {
            continue;
        }
        if (is_dir($sourcePath)) {
            // Avoid following a newly-created destination when it sits inside the source tree.
            if (str_starts_with($destination . DIRECTORY_SEPARATOR, $sourcePath . DIRECTORY_SEPARATOR)) {
                continue;
            }
            copyDirectory($sourcePath, $targetPath);
            continue;
        }
        if (!copy($sourcePath, $targetPath)) {
            throw new RuntimeException('Could not copy framework file: ' . $sourcePath);
        }
        chmod($targetPath, fileperms($sourcePath) & 0777);
    }
}

function removeDirectory(string $path): void
{
    if (!is_dir($path)) {
        return;
    }
    $iterator = new RecursiveIteratorIterator(
        new RecursiveDirectoryIterator($path, FilesystemIterator::SKIP_DOTS),
        RecursiveIteratorIterator::CHILD_FIRST
    );
    foreach ($iterator as $item) {
        $item->isDir() && !$item->isLink() ? rmdir($item->getPathname()) : unlink($item->getPathname());
    }
    rmdir($path);
}

function assertSafeName(string $name): void
{
    if (!preg_match('/^[A-Za-z][A-Za-z0-9_-]*$/', $name)) {
        throw new InvalidArgumentException('Use letters, numbers, underscore, or hyphen in generated names.');
    }
}

function studly(string $value): string
{
    return str_replace(' ', '', ucwords(str_replace(['-', '_'], ' ', $value)));
}

function snakePlural(string $value): string
{
    $snake = strtolower((string) preg_replace('/(?<!^)[A-Z]/', '_$0', $value));
    if (str_ends_with($snake, 'y')) {
        return substr($snake, 0, -1) . 'ies';
    }
    return str_ends_with($snake, 's') ? $snake : $snake . 's';
}

function normalizeMigrationTable(string $name): string
{
    $table = strtolower(trim($name));
    $table = preg_replace('/^create_/', '', $table) ?? $table;
    $table = preg_replace('/_table$/', '', $table) ?? $table;
    $table = str_replace('-', '_', $table);

    if (!preg_match('/^[a-z_][a-z0-9_]*$/', $table)) {
        throw new InvalidArgumentException('Use a table name containing only letters, numbers, and underscores.');
    }

    return $table;
}
