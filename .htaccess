Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L,NC]
    RewriteRule ^(?:app|bin|bootstrap|config|database|docs|packages|src|storage|tests|vendor)(?:/|$) - [F,L,NC]
    RewriteRule ^(?:\.duck(?:\..*)?|composer\.(?:json|lock)|README(?:\.md)?|artisan(?:\.bat)?|jeep(?:\.bat)?|server\.php)$ - [F,L,NC]

    RewriteRule ^public/ - [L]
    RewriteRule ^$ public/index.php [L]
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
