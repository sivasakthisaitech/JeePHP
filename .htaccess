Options -Indexes
DirectoryIndex public/index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L,NC]
    RewriteRule ^(?:app|bin|bootstrap|config|database|src|vendor)(?:/|$) - [F,L,NC]
    RewriteRule ^(?:\.duck(?:\..*)?|composer\.(?:json|lock)|README(?:\.md)?|jeep(?:\.bat)?)$ - [F,L,NC]

    RewriteRule ^public/ - [L]
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
